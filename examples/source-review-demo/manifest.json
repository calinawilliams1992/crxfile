{
  "manifest_version": 3,
  "name": "Source Review Demo",
  "version": "1.0.0",
  "permissions": ["storage"],
  "background": { "service_worker": "worker.js" },
  "content_scripts": [
    {
      "matches": ["https://example.com/*"],
      "js": ["content.js"]
    }
  ],
  "action": { "default_popup": "popup.html" }
}
